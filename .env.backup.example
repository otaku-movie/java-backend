# PostgreSQL 备份服务环境变量示例
# 复制为 .env.backup（仅本机使用，不要提交）并按需调整：
#   cp .env.backup.example .env.backup

# === 数据库连接 =========================================================
# 默认 postgres（叠加 docker-compose.yml/prod 时连容器内的 PG 服务名）
# 叠加 docker-compose.dev.yml 时改为 host.docker.internal，连宿主机 PG
PGBACKUP_HOST=postgres
PGBACKUP_PORT=5432
PGBACKUP_USER=postgres
PGBACKUP_PASSWORD=postgre
PGBACKUP_DATABASE=test_movie

# === 备份策略 ===========================================================
# 标准 cron 表达式（容器时区 Asia/Tokyo）。默认每天凌晨 3 点
PGBACKUP_CRON=0 3 * * *
# 本地最多保留多少天的备份
PGBACKUP_RETENTION_DAYS=30
# 容器启动时是否立即执行一次备份（用于验证）
PGBACKUP_RUN_ON_START=false

# === 可选：S3 / MinIO 双份 ==============================================
# 留空则只保留本地备份；填写后每次备份完会上传到指定 bucket
# 远端的过期清理建议交由 S3/MinIO 的 lifecycle 规则处理（更可靠）
# PGBACKUP_S3_ENDPOINT=https://your-minio.example.com
# PGBACKUP_S3_BUCKET=movie-db-backup
# PGBACKUP_S3_PREFIX=pg-backup
# PGBACKUP_S3_ACCESS_KEY=your-access-key
# PGBACKUP_S3_SECRET_KEY=your-secret-key
